{
    "routes": [
        {
            "src": "/style.css",
            "dest": "/style.css",
            "headers": {
                "Content-Type": "text/css"
            }
        },
        {
            "src": "/script.js",
            "dest": "/script.js",
            "headers": {
                "Content-Type": "application/javascript"
            }
        },
        {
            "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot))",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}
